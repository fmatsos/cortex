{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git commit *": "ask",
      "git push *": "ask",
      "rm *": "ask"
    },
    "skill": {
      "*": "allow"
    }
  },
  "model": "github-copilot/gpt-5-mini",
  "small_model": "github-copilot/gpt-5-mini",
  "agent": {
    "general": {
      "temperature": 0.3
    },
    "plan": {
      "temperature": 0.2
    },
    "build": {
      "temperature": 0.1
    },
    "analyze": {
      "temperature": 0.3
    }
  },
  "mcp": {
    "serena": {
      "enabled": true,
      "type": "local",
      "command": ["uvx", "--from", "git+https://github.com/oraios/serena", "serena", "start-mcp-server", "--project", "$(pwd)"]
    },
    "cortex": {
      "enabled": true,
      "type": "local",
      "command": ["cortex", "-c", ".ai/cortex/config.yaml", "start-mcp-server"]
    }
  },
  "tools": {
    "serena_get_memory": false,
    "serena_read_memory": false
  }
}
