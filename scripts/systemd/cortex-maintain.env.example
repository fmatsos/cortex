# /etc/cortex/maintain.env (chmod 640, root:runner): read by cortex-maintain.service.
# llama.cpp (chat, embeddings, d3-mini judge) is not on this machine: the same base URL as cortex.json / site.yml.
OPENAI_BASE_URL=http://192.168.1.116:8080/v1
# OPENAI_API_KEY=
# bun is not in the PATH of a service: put its folder here if /usr/local/bin/cortex cannot find it.
# PATH=/home/runner/.bun/bin:/usr/local/bin:/usr/bin:/bin
# Push the review branch to the remote after the commit (default: local only).
# MAINTAIN_PUSH=1
# At most N candidates per subtask (default: all).
# MAINTAIN_LIMIT=20
# MAINTAIN_REMOTE=origin
# MAINTAIN_BASE=main
