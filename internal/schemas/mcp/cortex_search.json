{
  "name": "cortex_search",
  "description": "Search memories using semantic similarity",
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Search query text"
      },
      "top_k": {
        "type": "integer",
        "description": "Number of results to return",
        "default": 5
      },
      "min_score": {
        "type": "number",
        "description": "Minimum similarity score (0-1)",
        "default": 0.5
      },
      "level": {
        "type": "string",
        "description": "Filter by memory level",
        "enum": ["working", "episodic", "semantic"]
      },
      "session_id": {
        "type": "string",
        "description": "Filter working memories by session ID"
      },
      "include_obsolete": {
        "type": "boolean",
        "description": "Include obsolete memories",
        "default": false
      }
    },
    "required": ["query"]
  }
}
