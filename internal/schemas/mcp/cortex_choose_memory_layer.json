{
  "name": "cortex_choose_memory_layer",
  "description": "Return a decision prompt to help choose the correct memory layer for a new memory.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "description": "Optional memory title"
      },
      "content": {
        "type": "string",
        "description": "Memory content to classify"
      },
      "tags": {
        "type": "array",
        "description": "Optional tags",
        "items": {
          "type": "string"
        }
      },
      "session_id": {
        "type": "string",
        "description": "Optional session ID if the memory might be working-level"
      }
    },
    "required": ["content"]
  }
}
