{
  "name": "cortex_list",
  "description": "List memories. Excludes obsolete memories by default; set include_obsolete=true to include them.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "level": {
        "type": "string",
        "description": "Filter by memory level",
        "enum": ["working", "episodic", "semantic"]
      },
      "include_obsolete": {
        "type": "boolean",
        "description": "Include obsolete memories",
        "default": false
      }
    }
  }
}
