{
  "name": "cortex_create",
  "description": "Create a new memory",
  "inputSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "description": "Memory title"
      },
      "content": {
        "type": "string",
        "description": "Memory content"
      },
      "type": {
        "type": "string",
        "description": "Memory type",
        "enum": ["solution", "issue", "analysis", "rule", "any"]
      },
      "tags": {
        "type": "array",
        "description": "Optional tags",
        "items": {
          "type": "string"
        }
      }
    },
    "required": ["title", "content", "type"]
  }
}
