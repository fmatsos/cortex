{
  "name": "cortex_create",
  "description": "Create a new memory",
  "inputSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "description": "Memory title"
      },
      "content": {
        "type": "string",
        "description": "Memory content"
      },
      "level": {
        "type": "string",
        "description": "Memory level",
        "enum": [
          "working",
          "episodic",
          "semantic"
        ]
      },
      "tags": {
        "type": "array",
        "description": "Optional tags",
        "items": {
          "type": "string"
        }
      },
      "session_id": {
        "type": "string",
        "description": "Session ID (required for working level)"
      },
      "source": {
        "type": "string",
        "description": "Source (manual|auto|llm)",
        "enum": [
          "manual",
          "auto",
          "llm"
        ]
      },
      "task_id": {
        "type": "string",
        "description": "Optional task ID"
      },
      "author": {
        "type": "string",
        "description": "Optional author"
      },
      "git_branch": {
        "type": "string",
        "description": "Git branch name (auto-detected if omitted)"
      },
      "agent_name": {
        "type": "string",
        "description": "AI agent name (e.g. Claude, Copilot)"
      },
      "agent_session_id": {
        "type": "string",
        "description": "AI agent session ID"
      },
      "user_prompt": {
        "type": "string",
        "description": "Triggering user prompt"
      }
    },
    "required": [
      "title",
      "content",
      "level"
    ]
  }
}