{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SearchOutput",
  "description": "Output schema for cortex search command",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "Memory UUID"
      },
      "title": {
        "type": "string",
        "description": "Memory title"
      },
      "level": {
        "type": "string",
        "enum": ["working", "episodic", "semantic"],
        "description": "Memory level"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Memory tags"
      },
      "score": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "description": "Similarity score"
      }
    },
    "required": ["id", "title", "level", "score"]
  }
}
