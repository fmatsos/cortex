{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImportOutput",
  "description": "Output schema for cortex import command",
  "type": "object",
  "properties": {
    "imported": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of successfully imported memories"
    },
    "failed": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of failed imports"
    },
    "skipped": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of skipped imports"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File path"
          },
          "status": {
            "type": "string",
            "enum": ["imported", "failed", "skipped"],
            "description": "Import status"
          },
          "id": {
            "type": "string",
            "description": "Memory ID (if imported)"
          },
          "title": {
            "type": "string",
            "description": "Memory title (if imported)"
          },
          "error": {
            "type": "string",
            "description": "Error message (if failed)"
          },
          "reason": {
            "type": "string",
            "description": "Skip reason (if skipped)"
          }
        },
        "required": ["path", "status"]
      },
      "description": "Per-file import results"
    }
  },
  "required": ["imported", "failed", "skipped", "files"]
}
