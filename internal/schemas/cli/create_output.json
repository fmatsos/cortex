{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateOutput",
  "description": "Output schema for cortex create command",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Memory UUID"
    },
    "title": {
      "type": "string",
      "description": "Memory title"
    },
    "level": {
      "type": "string",
      "enum": ["working", "episodic", "semantic"],
      "description": "Memory level"
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    }
  },
  "required": ["id", "title", "level", "created"]
}
