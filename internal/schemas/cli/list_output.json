{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ListOutput",
  "description": "Output schema for cortex list command",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "Memory UUID"
      },
      "title": {
        "type": "string",
        "description": "Memory title"
      },
      "types": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["solution", "issue", "analysis", "rule", "any"]
        },
        "description": "Memory types"
      },
      "created": {
        "type": "string",
        "format": "date-time",
        "description": "Creation timestamp"
      },
      "obsolete": {
        "type": "boolean",
        "description": "Whether memory is obsolete"
      }
    },
    "required": ["id", "title", "types", "created", "obsolete"]
  }
}
