{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ListOutput",
  "description": "Output schema for cortex list command",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "Memory UUID"
      },
      "title": {
        "type": "string",
        "description": "Memory title"
      },
      "level": {
        "type": "string",
        "enum": ["working", "episodic", "semantic"],
        "description": "Memory level"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Memory tags"
      },
      "created_at": {
        "type": "string",
        "format": "date-time",
        "description": "Creation timestamp"
      },
      "obsolete": {
        "type": "boolean",
        "description": "Whether memory is obsolete"
      }
    },
    "required": ["id", "title", "level", "created_at", "obsolete"]
  }
}
