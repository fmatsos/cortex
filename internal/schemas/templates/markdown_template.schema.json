{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortex-ai.github.io/schemas/markdown-template.schema.json",
  "title": "Cortex Markdown Template Schema",
  "description": "Schema for customizing Markdown export templates in Cortex",
  "type": "object",
  "properties": {
    "memory": {
      "type": "object",
      "description": "Template for single memory export",
      "properties": {
        "frontmatter": {
          "type": "object",
          "description": "YAML frontmatter structure",
          "properties": {
            "include_id": {
              "type": "boolean",
              "default": true,
              "description": "Include memory ID in frontmatter"
            },
            "include_dates": {
              "type": "boolean",
              "default": true,
              "description": "Include created_at and updated_at"
            },
            "include_metadata": {
              "type": "boolean",
              "default": true,
              "description": "Include custom metadata"
            },
            "date_format": {
              "type": "string",
              "default": "2006-01-02T15:04:05Z07:00",
              "description": "Go time format for dates"
            }
          }
        },
        "body": {
          "type": "string",
          "description": "Go template for the body content. Available variables: .Title, .Content, .Types, .Tags, .CreatedAt, .UpdatedAt",
          "default": "{{.Content}}"
        }
      }
    },
    "synthesis": {
      "type": "object",
      "description": "Template for synthesis document export",
      "properties": {
        "frontmatter": {
          "type": "object",
          "properties": {
            "date_format": {
              "type": "string",
              "default": "2006-01-02T15:04:05Z07:00"
            }
          }
        },
        "header": {
          "type": "string",
          "description": "Go template for document header",
          "default": "# {{.Intent | title}} - Synthesis\n\nThis document synthesizes {{len .Results}} memories related to \"{{.Intent}}\"."
        },
        "summary_section": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "default": "## Summary"
            },
            "content": {
              "type": "string",
              "default": "Based on the stored memories, the following information was found:"
            }
          }
        },
        "learnings_section": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "default": "## Key Learnings"
            },
            "item_template": {
              "type": "string",
              "description": "Template for each memory. Variables: .Title, .Score, .Content",
              "default": "### From: {{.Title}} (score: {{printf \"%.2f\" .Score}})\n\n{{.Content}}"
            },
            "content_preview_length": {
              "type": "integer",
              "default": 500,
              "description": "Max characters to show from each memory content"
            }
          }
        },
        "footer": {
          "type": "string",
          "default": "---\n\n*Generated by Cortex - This is a read-only synthesis, not importable.*"
        }
      }
    }
  }
}
